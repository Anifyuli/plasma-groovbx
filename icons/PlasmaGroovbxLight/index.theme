[Icon Theme]
Name=Plasma Groovbx Light
Comment=Light-background variant of Plasma Groovbx: restores the 3rd-party app icons removed from Breeze by MR !477, tuned for use against light Gruvbox backgrounds
Inherits=breeze,breeze-dark,hicolor
FollowsColorScheme=true
Hidden=false
Example=libreoffice-writer

Directories=apps/16,apps/22,apps/32,apps/48,actions/16,actions/22,actions/24,actions/32,actions/48,applets/64,devices/16,devices/22,devices/32,devices/64,emblems/16,mimetypes/16,mimetypes/22,mimetypes/32,mimetypes/64,places/16,places/22,places/32,places/48,places/64,places/96,preferences/22,preferences/32,status/22,status/24,scalable/apps,actions/12,actions/16@2x,actions/16@3x,actions/22@2x,actions/22@3x,actions/24@2x,actions/24@3x,actions/32@2x,actions/32@3x,actions/64,animations/16,animations/16@2x,animations/16@3x,animations/22,apps/16@2x,apps/16@3x,apps/22@2x,apps/22@3x,applets/16,applets/22,applets/48,applets/128,applets/256,categories/22,categories/32,devices/16@2x,devices/16@3x,devices/22@2x,devices/22@3x,devices/32@2x,devices/32@3x,emblems/8,emblems/16@2x,emblems/16@3x,emblems/22,emblems/22@2x,emblems/22@3x,emotes/22,emotes/22@2x,emotes/22@3x,mimetypes/16@2x,mimetypes/16@3x,mimetypes/22@2x,mimetypes/22@3x,places/16@2x,places/16@3x,places/22@2x,places/22@3x,status/16,status/16@2x,status/16@3x,status/22@2x,status/22@3x,status/32,status/48,status/64

